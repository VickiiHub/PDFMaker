{ 
  "version": 2, 
  "builds" : [
    {"src" : "./src/server.js", "use" : "@vercel/node"}
  ],
  "routes" : [
    { "src" : "./(.*)", "dest" : "/src" }
  ],
  "rewrites": [
    { "source": "/src/(.*)", "destination": "/src/index.js" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ]
}